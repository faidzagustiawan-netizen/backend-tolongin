datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. USER MANAGEMENT & SECURITY
// ==========================================

enum Role {
  TALENT
  COMPANY
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String?
  passwordHash String
  role         Role     @default(TALENT)
  isVerified   Boolean  @default(false)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  talentProfile       TalentProfile?
  companyProfile      CompanyProfile?
  teamMemberships     CompanyMember[]
  activityLogs        CompanyActivityLog[]
  discussions         Discussion[]
  notifications       Notification[]
  tokenTransactions   TokenTransaction[]
  paymentTransactions PaymentTransaction[]
  systemAuditLogs     SystemAuditLog[]
  supportTickets      SupportTicket[]
  ticketReplies       TicketReply[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Token pemulihan kata sandi.
///
/// Yang disimpan adalah SHA-256 dari token, bukan tokennya. Kebocoran isi tabel
/// karena itu tidak cukup untuk mengambil alih akun. Token sekali pakai:
/// `usedAt` diisi saat ditukar, dan seluruh token milik pengguna yang sama
/// dihapus setelah kata sandi berhasil diganti.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model TalentProfile {
  id          String   @id @default(uuid())
  slug        String   @unique @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  avatarUrl   String?
  bio         String?
  resumeUrl   String?
  skills      String[]
  githubUrl   String?
  linkedinUrl String?
  figmaUrl    String?

  // AI Identity & Security
  faceVerificationStatus VerificationStatus @default(UNVERIFIED)
  ktpNik                 String?            @unique // Untuk memastikan 1 identitas KTP 1 akun
  // Hash berkas selfie. Hanya menangkap unggahan gambar yang identik byte-per-byte,
  // jadi perannya sebatas saringan awal yang murah. Pemeriksaan "1 wajah 1 akun"
  // yang sebenarnya memakai biometricFeatureVector di bawah.
  biometricDataHash      String?            @unique
  // Embedding wajah Facenet512, sudah di-L2-normalize sehingga jarak cosine
  // antar-baris sebanding. Ditulis HANYA oleh VerificationService dari selfie
  // yang sudah ter-align dan cocok dengan KTP.
  //
  // Tipe `vector` berasal dari extension pgvector dan tidak dikenali Prisma
  // Client — itu disengaja: kolom ini tidak boleh ikut terbawa ke respons API
  // mana pun, dan seluruh akses dilakukan lewat $queryRaw di IdentityDedupeService.
  biometricFeatureVector Unsupported("vector(512)")?

  // Selfie atau KTP gagal diluruskan (wajah tidak terdeteksi). Verifikasi tetap
  // bisa lolos dengan ambang lebih ketat, tetapi embedding-nya tidak disimpan
  // karena tidak layak dijadikan acuan pembanding.
  faceAlignmentDegraded  Boolean            @default(false)

  // Hasil pemeriksaan duplikat wajah saat verifikasi.
  needsIdentityReview    Boolean            @default(false)
  duplicateCheckDistance Float?
  duplicateCheckMatchId  String?
  identityReviewedAt     DateTime?
  identityReviewedBy     String?

  // Leaderboard & Demographics
  location     String?
  roleCategory String?

  // Privacy & Encryption
  encryptedPrivateFace String? // Gambar selfie terenkripsi AES-256 untuk liveness
  encryptedKtpData     String? // Gambar KTP terenkripsi AES-256 untuk audit

  // Gamification & Economy
  xp           Int @default(0)
  level        Int @default(1)
  tokenBalance Int @default(0)

  showcasedSubmissionIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       ChallengeEnrollment[]
  submissions       Submission[]
  portfolios        Portfolio[]
  earnedBadges      TalentBadge[]
  createdChallenges Challenge[]           @relation("CreatedChallenges")

  experiences       Experience[]
  educations        Education[]

  // Leaderboard mengurutkan berdasarkan XP menurun.
  @@index([xp(sort: Desc)])
  // Antrean tinjau identitas untuk admin.
  @@index([needsIdentityReview])
  @@map("talent_profiles")
}

model Experience {
  id          String        @id @default(uuid())
  talentId    String
  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  title          String
  companyName    String
  employmentType String?
  locationType   String?
  location       String?
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean       @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experiences")
}

model Education {
  id           String        @id @default(uuid())
  talentId     String
  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  activities   String?
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("skills")
}

// ==========================================
// 2. COMPANY & SUBSCRIPTION MODEL
// ==========================================

enum SubscriptionTier {
  STARTUP
  KONGLOMERAT
  CUSTOM
}

model CompanyProfile {
  id          String  @id @default(uuid())
  slug        String  @unique @default(uuid())
  userId      String  @unique // Akun PIC Perusahaan
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  logoUrl     String?
  description String?
  websiteUrl  String?
  industry    String
  companySize String?
  location    String?
  linkedinUrl String?

  // Validasi KYB (Know Your Business) & Subscription
  kybStatus             VerificationStatus @default(UNVERIFIED)
  subscriptionTier      SubscriptionTier   @default(STARTUP)
  subscriptionExpiresAt DateTime?

  // Accountability & Team
  trustScore Int     @default(100)
  // Kode undangan sekali-pakai dan berumur pendek. Dikosongkan setelah dipakai
  // atau setelah inviteCodeExpiresAt terlewat.
  inviteCode           String?   @unique
  inviteCodeExpiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges   Challenge[]
  teamMembers  CompanyMember[]
  activityLogs CompanyActivityLog[]

  // Direktori perusahaan diurutkan berdasarkan trustScore menurun.
  @@index([trustScore(sort: Desc)])
  @@index([subscriptionExpiresAt])
  @@map("company_profiles")
}

model CompanyMember {
  id        String   @id @default(uuid())
  companyId String
  userId    String   @unique
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  joinedAt  DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_members")
}

model CompanyActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_activity_logs")
}

// ==========================================
// 3. CHALLENGE DIRECTORY & AI GENERATION
// ==========================================

enum ChallengeType {
  COMPANY
  PUBLIC
}

enum ChallengeCategory {
  UI_UX
  FRONTEND
  BACKEND
  DATA_SCIENCE
  MARKETING
  PRODUCT
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Challenge {
  id        String          @id @default(uuid())
  companyId String?
  company   CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  talentId  String?
  creator   TalentProfile?  @relation("CreatedChallenges", fields: [talentId], references: [id], onDelete: SetNull)

  challengeType ChallengeType       @default(COMPANY)
  title         String
  slug          String              @unique
  summary       String
  description   String // Detail studi kasus / problem statement
  category      ChallengeCategory
  difficulty    ChallengeDifficulty

  // Resource & Aset
  datasetUrl        String?
  mockApiUrl        String?
  brandGuidelineUrl String?
  briefAttachments  Json? // For images, videos, documents, external links related to brief

  // Rubrik Penilaian (Penyimpanan JSON untuk fleksibilitas kriteria)
  gradingRubric Json

  // Pengaturan pengawasan ujian. Dulu diselipkan sebagai satu kunci di dalam
  // gradingRubric, sehingga setiap perhitungan bobot kriteria harus ingat
  // menyaringnya keluar dan tiap pembaca menebak-nebak bentuknya.
  proctoringSettings Json?

  rewardDescription String?
  startsAt          DateTime?
  deadlineAt        DateTime?
  isPrivate         Boolean         @default(false)
  status            ChallengeStatus @default(DRAFT)

  // AI Challenge Generator Tracking
  createdByAi  Boolean @default(false)
  aiPromptUsed String?

  // Template System
  isTemplate   Boolean @default(false)
  templateRole String? // e.g. "Junior Frontend Developer"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments ChallengeEnrollment[]
  submissions Submission[]
  discussions Discussion[]
  components  ChallengeComponent[]
  sections    ChallengeSection[]

  // Direktori publik selalu menyaring status + isPrivate lalu mengurutkan
  // berdasarkan createdAt menurun.
  @@index([status, isPrivate, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([category])
  @@index([difficulty])
  @@map("challenges")
}

enum SectionStageType {
  QUIZ
  ASSIGNMENT
}

model ChallengeSection {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int     @default(0)

  // Builder soal sudah lama mengirim kedua kolom ini, tetapi sebelumnya tidak
  // ada tempat menyimpannya sehingga "Waktu Pengerjaan Per Tahap" selalu
  // hilang setelah disimpan.
  stageType SectionStageType @default(ASSIGNMENT)
  timeLimit Int? // menit; null = tak terbatas

  components ChallengeComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("challenge_sections")
}

enum ComponentType {
  MULTIPLE_CHOICE
  ESSAY
  FILE_UPLOAD
  VIDEO_UPLOAD
  URL_SUBMISSION
  LIVE_CODING
}

model ChallengeComponent {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  sectionId String?
  section   ChallengeSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  type        ComponentType
  question    String
  description String?
  options     Json? // Jika MULTIPLE_CHOICE: [{id, text, isCorrect}]
  metadata    Json? // Konfigurasi lain misal: language untuk LIVE_CODING, durasi untuk VIDEO
  points      Int           @default(10)
  order       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ComponentResponse[]

  @@map("challenge_components")
}

// ==========================================
// 4. WORKSPACE & SUBMISSION
// ==========================================

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  DROPPED
}

model ChallengeEnrollment {
  id          String        @id @default(uuid())
  talentId    String
  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  status      EnrollmentStatus @default(ENROLLED)
  ndaSignedAt DateTime?
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  draftData   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  @@unique([talentId, challengeId])
  @@index([talentId, updatedAt(sort: Desc)])
  @@index([challengeId])
  @@map("challenge_enrollments")
}

enum SubmissionStatus {
  PENDING_AI
  UNDER_REVIEW
  PASSED
  FAILED
}

enum HiringStatus {
  NONE
  SHORTLISTED
  INTERVIEW_INVITED
  HIRED
  REJECTED
}

model Submission {
  id           String              @id @default(uuid())
  enrollmentId String
  enrollment   ChallengeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  talentId     String
  talent       TalentProfile       @relation(fields: [talentId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  // Solusi yang dikumpulkan
  solutionFilesUrl String?
  repositoryUrl    String?
  figmaUrl         String?
  liveDemoUrl      String?
  notes            String?

  // Penanda bahwa perusahaan sudah diingatkan soal SLA tinjauan 7 hari.
  // Menjaga pengingat harian tidak berubah menjadi spam harian.
  slaReminderSentAt DateTime?

  // AI Correction & Integrity
  aiPlagiarismScore   Float? // 0.0 - 100.0%
  aiCorrectionSummary String? // Analisis otomatis dari AI
  aiScore             Float? // Skor awal dari AI (0-100)
  
  // Soft Skills
  softSkillScore      Float? // Agregasi skor soft skill (0-100)
  softSkillFeedback   String? // Feedback AI khusus kepribadian/soft skill
  
  // Career Development
  weaknessTags        String[] @default([])

  // Review Manusia & Keputusan
  finalScore       Float? // Skor dari rekruter
  reviewerFeedback String? // Ulasan kualitatif
  status           SubmissionStatus @default(PENDING_AI)
  hiringStatus     HiringStatus     @default(NONE)
  autoPassed       Boolean          @default(false)
  evaluatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio          Portfolio?
  componentResponses ComponentResponse[]

  // Cron evaluasi AI berjalan tiap 30 detik dan menyaring status PENDING_AI
  // lalu mengurutkan createdAt menaik. Tanpa indeks ini seluruh tabel dipindai
  // dua kali per menit.
  @@index([status, createdAt])
  @@index([challengeId, status])
  @@index([talentId])
  @@index([enrollmentId])
  @@map("submissions")
}

model ComponentResponse {
  id           String             @id @default(uuid())
  submissionId String
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  componentId  String
  component    ChallengeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  // Nilai jawaban fleksibel
  textValue String? // Untuk Essay, URL, Live Coding, Option ID
  fileUrl   String? // Untuk File/Video

  score      Float? // Penilaian
  aiFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("component_responses")
}

// ==========================================
// 5. DISKUSI & Q&A
// ==========================================

model Discussion {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  message  String
  parentId String? // Untuk thread balasan (self-referencing)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([challengeId, createdAt])
  @@index([parentId])
  @@map("discussions")
}

// ==========================================
// 6. PORTFOLIO SHOWCASE
// ==========================================

model Portfolio {
  id           String        @id @default(uuid())
  talentId     String
  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  isPublic         Boolean @default(true)
  verifiedBadgeUrl String?
  showcaseSummary  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portfolios")
}

// ==========================================
// 7. GAMIFICATION & NOTIFICATIONS
// ==========================================

model Badge {
  id          String @id @default(uuid())
  title       String @unique
  description String
  iconUrl     String
  requiredXp  Int    @default(0)

  earnedBy TalentBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("badges")
}

model TalentBadge {
  id       String        @id @default(uuid())
  talentId String
  talent   TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime      @default(now())

  @@unique([talentId, badgeId])
  @@map("talent_badges")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  // Lonceng notifikasi menghitung yang belum dibaca per pengguna.
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ==========================================
// 8. TOKEN ECONOMY
// ==========================================

enum TokenType {
  EARN
  SPEND
}

model TokenTransaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        TokenType
  description String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("token_transactions")
}

// ==========================================
// 9. PAYMENT GATEWAY (MIDTRANS)
// ==========================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentType {
  TOKEN_TOPUP
  SUBSCRIPTION
}

model PaymentTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalId  String        @unique // Midtrans order_id
  checkoutUrl String? // Midtrans redirect_url
  amount      Int
  status      PaymentStatus @default(PENDING)
  paymentType PaymentType

  metadata Json? // Untuk menyimpan data spesifik paket (misal: tokenAmount)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payment_transactions")
}

// ==========================================
// 10. ADVANCED SUPER ADMIN FEATURES
// ==========================================

model SystemAuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "BANNED_USER", "CREATED_ANNOUNCEMENT"
  entityType String // e.g. "USER", "CHALLENGE"
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@map("system_audit_logs")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      TicketStatus @default(OPEN)

  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model TicketReply {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_replies")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  MAINTENANCE
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}
