datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. USER MANAGEMENT & SECURITY
// ==========================================

enum Role {
  TALENT
  COMPANY
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String?
  passwordHash String
  role         Role     @default(TALENT)
  isVerified   Boolean  @default(false)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  talentProfile       TalentProfile?
  companyProfile      CompanyProfile?
  teamMemberships     CompanyMember[]
  activityLogs        CompanyActivityLog[]
  discussions         Discussion[]
  notifications       Notification[]
  tokenTransactions   TokenTransaction[]
  paymentTransactions PaymentTransaction[]
  systemAuditLogs     SystemAuditLog[]
  supportTickets      SupportTicket[]
  ticketReplies       TicketReply[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Token pemulihan kata sandi.
///
/// Yang disimpan adalah SHA-256 dari token, bukan tokennya. Kebocoran isi tabel
/// karena itu tidak cukup untuk mengambil alih akun. Token sekali pakai:
/// `usedAt` diisi saat ditukar, dan seluruh token milik pengguna yang sama
/// dihapus setelah kata sandi berhasil diganti.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model TalentProfile {
  id          String   @id @default(uuid())
  slug        String   @unique @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  avatarUrl   String?
  bio         String?
  resumeUrl   String?
  skills      String[]
  githubUrl   String?
  linkedinUrl String?
  figmaUrl    String?

  // AI Identity & Security
  faceVerificationStatus VerificationStatus          @default(UNVERIFIED)
  ktpNik                 String?                     @unique // Untuk memastikan 1 identitas KTP 1 akun
  // Hash berkas selfie. Hanya menangkap unggahan gambar yang identik byte-per-byte,
  // jadi perannya sebatas saringan awal yang murah. Pemeriksaan "1 wajah 1 akun"
  // yang sebenarnya memakai biometricFeatureVector di bawah.
  biometricDataHash      String?                     @unique
  // Embedding wajah Facenet512, sudah di-L2-normalize sehingga jarak cosine
  // antar-baris sebanding. Ditulis HANYA oleh VerificationService dari selfie
  // yang sudah ter-align dan cocok dengan KTP.
  //
  // Tipe `vector` berasal dari extension pgvector dan tidak dikenali Prisma
  // Client — itu disengaja: kolom ini tidak boleh ikut terbawa ke respons API
  // mana pun, dan seluruh akses dilakukan lewat $queryRaw di IdentityDedupeService.
  biometricFeatureVector Unsupported("vector(512)")?

  // Selfie atau KTP gagal diluruskan (wajah tidak terdeteksi). Verifikasi tetap
  // bisa lolos dengan ambang lebih ketat, tetapi embedding-nya tidak disimpan
  // karena tidak layak dijadikan acuan pembanding.
  faceAlignmentDegraded Boolean @default(false)

  // Hasil pemeriksaan duplikat wajah saat verifikasi.
  needsIdentityReview    Boolean   @default(false)
  duplicateCheckDistance Float?
  duplicateCheckMatchId  String?
  identityReviewedAt     DateTime?
  identityReviewedBy     String?

  // Leaderboard & Demographics
  location     String?
  roleCategory String?

  // Privacy & Encryption
  encryptedPrivateFace String? // Gambar selfie terenkripsi AES-256 untuk liveness
  encryptedKtpData     String? // Gambar KTP terenkripsi AES-256 untuk audit

  // Gamification & Economy
  xp           Int @default(0)
  level        Int @default(1)
  tokenBalance Int @default(0)

  showcasedSubmissionIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       ChallengeEnrollment[]
  submissions       Submission[]
  portfolios        Portfolio[]
  earnedBadges      TalentBadge[]
  createdChallenges Challenge[]           @relation("CreatedChallenges")

  experiences Experience[]
  educations  Education[]

  // Leaderboard mengurutkan berdasarkan XP menurun.
  @@index([xp(sort: Desc)])
  // Antrean tinjau identitas untuk admin.
  @@index([needsIdentityReview])
  @@map("talent_profiles")
}

model Experience {
  id             String        @id @default(uuid())
  talentId       String
  talent         TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  title          String
  companyName    String
  employmentType String?
  locationType   String?
  location       String?
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean       @default(false)
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experiences")
}

model Education {
  id           String        @id @default(uuid())
  talentId     String
  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  activities   String?
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Kosakata keahlian dipakai ulang sebagai penanda topik soal di bank.
  // Membuat daftar tag tersendiri berarti dua perbendaharaan kata yang harus
  // dijaga sinkron: "Node.js" milik talenta tidak akan cocok dengan "NodeJS"
  // milik soal, dan rekomendasi berdasarkan keahlian jadi meleset.
  questionTags QuestionBankItemSkill[]

  // Alasan yang sama berlaku untuk bidang pekerjaan. Dulu `ChallengeCategory`
  // adalah enum enam nilai: perusahaan yang mencari Video Editor tidak punya
  // tempat, dan bidang baru berarti migrasi basis data. Sekarang bidang diambil
  // dari kosakata yang sama dengan keahlian talenta, sehingga "Frontend
  // Development" yang dicari perusahaan adalah baris yang persis sama dengan
  // yang tercantum di profil kandidat.
  categorizedChallenges Challenge[]        @relation("ChallengeJobCategory")
  categorizedBankItems  QuestionBankItem[] @relation("QuestionBankItemCategory")

  @@map("skills")
}

// ==========================================
// 2. COMPANY & SUBSCRIPTION MODEL
// ==========================================

enum SubscriptionTier {
  STARTUP
  KONGLOMERAT
  CUSTOM
}

model CompanyProfile {
  id          String  @id @default(uuid())
  slug        String  @unique @default(uuid())
  userId      String  @unique // Akun PIC Perusahaan
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  logoUrl     String?
  description String?
  websiteUrl  String?
  industry    String
  companySize String?
  location    String?
  linkedinUrl String?

  // Validasi KYB (Know Your Business) & Subscription
  //
  // Berkas legalitas yang dikirim perusahaan disimpan di sini. Sebelumnya
  // POST /verification/kyb menerima nomor registrasi dan tautan dokumennya
  // lalu membuangnya — hanya kybStatus yang berubah. Akibatnya antrean
  // verifikasi admin menampilkan kartu tanpa satu pun dokumen untuk ditinjau,
  // dan persetujuannya menjadi formalitas kosong.
  legalEntityName            String?
  businessRegistrationNumber String?
  legalDocumentUrl           String?
  kybSubmittedAt             DateTime?

  kybStatus             VerificationStatus @default(UNVERIFIED)
  subscriptionTier      SubscriptionTier   @default(STARTUP)
  subscriptionExpiresAt DateTime?

  // Accountability & Team
  trustScore          Int       @default(100)
  // Kode undangan sekali-pakai dan berumur pendek. Dikosongkan setelah dipakai
  // atau setelah inviteCodeExpiresAt terlewat.
  inviteCode          String?   @unique
  inviteCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges   Challenge[]
  teamMembers  CompanyMember[]
  activityLogs CompanyActivityLog[]

  /**
   * Soal simpanan milik perusahaan ini; bank platform punya companyId null.
   */
  questionBankItems QuestionBankItem[]

  // Direktori perusahaan diurutkan berdasarkan trustScore menurun.
  @@index([trustScore(sort: Desc)])
  @@index([subscriptionExpiresAt])
  @@map("company_profiles")
}

model CompanyMember {
  id        String   @id @default(uuid())
  companyId String
  userId    String   @unique
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  joinedAt  DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_members")
}

model CompanyActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_activity_logs")
}

// ==========================================
// 3. CHALLENGE DIRECTORY & AI GENERATION
// ==========================================

enum ChallengeType {
  COMPANY
  PUBLIC
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Challenge {
  id        String          @id @default(uuid())
  companyId String?
  company   CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  talentId  String?
  creator   TalentProfile?  @relation("CreatedChallenges", fields: [talentId], references: [id], onDelete: SetNull)

  challengeType ChallengeType       @default(COMPANY)
  title         String
  slug          String              @unique
  summary       String
  description   String // Detail studi kasus / problem statement

  /// Posisi yang sedang direkrut, apa adanya menurut perusahaan.
  ///
  /// Sudah lama ditanyakan di layar pembuka ("Posisi atau peran yang dicari")
  /// tetapi hanya dipakai menyemai judul dan prompt AI, lalu dibuang. Ini yang
  /// perusahaan benar-benar tahu dan yang kandidat cari — `category` cuma enam
  /// keranjang untuk menyaring bank soal.
  role          String?

  /// Bidang pekerjaan, diambil dari kosakata `Skill` yang sama dengan keahlian
  /// talenta.
  ///
  /// Dulu enum `ChallengeCategory` dengan enam nilai plus OTHER. Enum berarti
  /// bidang baru butuh migrasi basis data, jadi perusahaan yang mencari Video
  /// Editor terpaksa memilih OTHER dan bidang sebenarnya hanya tersimpan sebagai
  /// teks bebas di `role`. Sekarang bidang yang belum ada bisa ditambahkan
  /// perusahaan saat itu juga (lewat `SkillsService.resolveCategory`, yang
  /// membedakan salah ketik dari bidang yang memang baru).
  ///
  /// null berarti lintas bidang — sama artinya dengan OTHER yang lama, dan
  /// itulah nilai yang diberikan kepada baris lama saat migrasi.
  categoryId    String?
  category      Skill?              @relation("ChallengeJobCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  difficulty    ChallengeDifficulty

  // Resource & Aset
  datasetUrl        String?
  mockApiUrl        String?
  brandGuidelineUrl String?
  briefAttachments  Json? // For images, videos, documents, external links related to brief

  // Rubrik Penilaian (Penyimpanan JSON untuk fleksibilitas kriteria)
  gradingRubric Json

  // Pengaturan pengawasan ujian. Dulu diselipkan sebagai satu kunci di dalam
  // gradingRubric, sehingga setiap perhitungan bobot kriteria harus ingat
  // menyaringnya keluar dan tiap pembaca menebak-nebak bentuknya.
  proctoringSettings Json?

  rewardDescription String?
  startsAt          DateTime?
  deadlineAt        DateTime?
  isPrivate         Boolean         @default(false)
  status            ChallengeStatus @default(DRAFT)

  /// Penurunan paksa oleh admin.
  ///
  /// Dulu moderasi memakai `prisma.challenge.delete`, dan rantai cascade-nya
  /// berujung di `Submission` lalu `Portfolio`: satu klik takedown menghapus
  /// permanen hasil kerja dan portofolio terverifikasi setiap talenta yang
  /// pernah ikut. Hukuman untuk perusahaan yang melanggar tidak boleh jatuh ke
  /// kandidatnya, jadi studi kasusnya sekarang ditutup dan ditandai, bukan
  /// dihapus — submisi, penilaian, dan portofolio tetap utuh.
  ///
  /// Bedanya dengan CLOSED biasa: CLOSED dipilih pemiliknya sendiri dan hanya
  /// membebaskan kuota, sedangkan tanda ini menyembunyikan studi kasus dari
  /// siapa pun kecuali admin dan pemiliknya, dan hanya admin yang bisa
  /// mencabutnya kembali.
  takenDownAt    DateTime?
  takenDownById  String?
  takedownReason String?

  // AI Challenge Generator Tracking
  createdByAi  Boolean @default(false)
  aiPromptUsed String?

  // Konsep template dibubarkan; bahannya pindah ke QuestionBankItem, yang
  // satuannya satu soal dan bukan satu ujian utuh.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments ChallengeEnrollment[]
  submissions Submission[]
  discussions Discussion[]
  components  ChallengeComponent[]
  sections    ChallengeSection[]

  // Direktori publik selalu menyaring status + isPrivate lalu mengurutkan
  // berdasarkan createdAt menurun.
  @@index([status, isPrivate, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([categoryId])
  @@index([difficulty])
  @@map("challenges")
}

/// Syarat yang harus dipenuhi kandidat untuk masuk sebuah tahap.
enum StageGateMode {
  /// Siapa pun yang sampai di sini boleh masuk. Perilaku bawaan, dan satu-
  /// satunya yang sah untuk tahap pertama.
  OPEN

  /// Butuh nilai minimal, lihat `minScore` dan `scoreBasis`.
  MIN_SCORE

  /// Kuota: hanya `maxAdvancing` kandidat teratas yang lanjut.
  TOP_N

  /// Perusahaan meloloskan satu per satu. Tidak ada ambang otomatis.
  MANUAL_APPROVAL
}

/// Nilai mana yang dibandingkan dengan ambang lolos.
enum GateScoreBasis {
  PREVIOUS_STAGE
  CUMULATIVE
  SPECIFIC_STAGES
}

/// Perlakuan ketika nilai tahap sumber belum siap.
///
/// Tahap berisi esai atau tugas tidak punya nilai sampai AI atau manusia
/// menilainya, jadi gerbang berbasis nilai selalu punya jeda. Ini yang
/// menentukan apa yang terjadi selama jeda itu — sengaja diatur per tahap,
/// karena tahap pilihan ganda tidak punya masalah ini sama sekali.
enum StagePendingPolicy {
  /// Tahan sampai nilai keluar; kandidat dinotifikasi saat tahapnya terbuka.
  WAIT_FOR_SCORE

  /// Tahan, tetapi buka otomatis setelah `graceDays` bila penilaian terlambat.
  /// Ambang nilai terlewati — itu harganya supaya kandidat tidak terjebak.
  AUTO_ADVANCE_AFTER

  /// Tidak ada ambang otomatis; hanya keputusan manusia yang membuka.
  MANUAL_ONLY
}

model ChallengeSection {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int     @default(0)

  // Builder soal sudah lama mengirim kolom ini, tetapi sebelumnya tidak ada
  // tempat menyimpannya sehingga "Waktu Pengerjaan Per Tahap" selalu hilang
  // setelah disimpan.
  timeLimit Int? // menit; null = tak terbatas

  // Jendela buka-tutup per tahap, di dalam jendela global challenge.
  // Sebelumnya hanya ada `Challenge.startsAt`/`deadlineAt`, jadi seluruh
  // tahapan terpaksa berbagi satu rentang waktu.
  opensAt  DateTime?
  closesAt DateTime?

  // Syarat masuk. Bawaannya OPEN supaya seluruh studi kasus yang sudah ada
  // berperilaku persis seperti sebelum kolom-kolom ini ada.
  gateMode      StageGateMode      @default(OPEN)
  minScore      Float? // 0-100, dipakai MIN_SCORE
  maxAdvancing  Int? // dipakai TOP_N
  scoreBasis    GateScoreBasis     @default(PREVIOUS_STAGE)
  /// Tahap yang nilainya dihitung ketika `scoreBasis = SPECIFIC_STAGES`.
  ///
  /// Menyimpan id, bukan urutan: urutan bisa digeser company dan rujukan yang
  /// memakainya akan berubah arti tanpa suara. Karena itu jalur update wajib
  /// mempertahankan `ChallengeSection.id` — lihat `writeSections`.
  gateSourceIds String[]           @default([])
  pendingPolicy StagePendingPolicy @default(WAIT_FOR_SCORE)
  graceDays     Int? // dipakai AUTO_ADVANCE_AFTER

  components  ChallengeComponent[]
  attempts    StageAttempt[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("challenge_sections")
}

enum StageAttemptStatus {
  /// Belum boleh dibuka; `lockReason` menjelaskan kenapa.
  LOCKED

  /// Sudah dibuka kandidat dan jamnya berjalan.
  IN_PROGRESS

  /// Jawaban masuk, menunggu perhitungan nilai.
  SUBMITTED

  /// Nilai objektif sudah dihitung, bagian yang butuh AI/manusia belum.
  AWAITING_GRADE

  PASSED
  FAILED

  /// Waktu habis sebelum dikumpulkan. Jawaban yang sudah tersimpan tetap
  /// dinilai apa adanya.
  EXPIRED
}

/// Satu baris per (pendaftaran, tahap): keadaan pengerjaan satu tahap oleh satu
/// kandidat.
///
/// Sebelum model ini ada, penilaian hanya mengenal satu `Submission` untuk
/// seluruh challenge, jadi tidak ada angka per tahap yang bisa dibandingkan
/// dengan ambang lolos — dan `ChallengeSection.timeLimit` tersimpan tanpa ada
/// yang menegakkannya.
model StageAttempt {
  id           String              @id @default(uuid())
  enrollmentId String
  enrollment   ChallengeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sectionId    String
  section      ChallengeSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  status StageAttemptStatus @default(LOCKED)

  /// Dicap saat kandidat menekan "Mulai Tahap", bukan saat halaman termuat.
  startedAt DateTime?

  /// `startedAt` + `timeLimit`. Otoritas tunggal atas batas waktu: hitungan di
  /// peramban hanya tampilan dan bisa dipalsukan, jadi penolakan pengumpulan
  /// selalu dibandingkan dengan kolom ini.
  expiresAt   DateTime?
  submittedAt DateTime?

  /// Nilai tahap ini, 0-100. Komponen psikometrik tidak ikut dihitung — skala
  /// Likert tidak punya jawaban benar.
  score    Float?
  gradedAt DateTime?

  unlockedAt DateTime?

  /// Alasan terkunci, sudah berbentuk kalimat siap tampil. Disimpan supaya
  /// peramban tidak perlu menghitung ulang aturan gerbang — satu-satunya yang
  /// memutuskan terbuka atau tidak adalah server.
  lockReason String?

  /// Jejak keputusan MANUAL_APPROVAL / MANUAL_ONLY.
  approvedById String?
  approvedAt   DateTime?

  submission Submission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, sectionId])
  // Cron kadaluarsa menyaring status lalu membandingkan expiresAt.
  @@index([status, expiresAt])
  // Peringkat TOP_N mengurutkan nilai di dalam satu tahap.
  @@index([sectionId, score(sort: Desc)])
  @@map("stage_attempts")
}

enum ComponentType {
  MULTIPLE_CHOICE
  ESSAY
  FILE_UPLOAD
  VIDEO_UPLOAD
  URL_SUBMISSION
  LIVE_CODING

  /// Soal skala Likert untuk psikotes. Tidak punya jawaban benar dan tidak
  /// menyumbang poin; hasilnya diringkas jadi profil per dimensi di
  /// `Submission.psychometricProfile`.
  PSYCHOMETRIC
}

model ChallengeComponent {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  sectionId String?
  section   ChallengeSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  type        ComponentType
  question    String
  description String?
  options     Json? // Jika MULTIPLE_CHOICE: [{id, text, isCorrect}]
  metadata    Json? // Konfigurasi lain misal: language untuk LIVE_CODING, durasi untuk VIDEO
  points      Int           @default(10)
  order       Int           @default(0)

  // Jejak asal bila soal ini dipungut dari bank.
  //
  // Sengaja hanya jejak, bukan sumber isi: soal disalin saat dipungut. Kalau
  // isinya dibaca lewat relasi ini, menyunting soal di bank akan mengubah
  // ujian yang sedang dikerjakan kandidat — dan ComponentResponse menunjuk
  // baris ini, sehingga jawaban yang sudah masuk menggantung ke pertanyaan
  // yang berbeda dari yang dijawab.
  sourceItemId String?
  sourceItem   QuestionBankItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ComponentResponse[]

  @@index([sourceItemId])
  @@map("challenge_components")
}

// ==========================================
// 3b. BANK SOAL MODULAR
// ==========================================

/**
 * Satu soal yang berdiri sendiri, lepas dari challenge mana pun.
 * Sebelum ini satuan terkecil yang bisa dipakai ulang adalah satu ujian utuh
 * (`Challenge.isTemplate`), yang hanya bisa disalin seluruhnya. Perusahaan
 * yang mencari Backend Engineer tidak bisa memungut tiga soal Database dan
 * dua soal API lalu menyusun tahapannya sendiri.
 */
model QuestionBankItem {
  id String @id @default(uuid())

  // null = bank platform, terlihat semua perusahaan.
  // terisi = koleksi pribadi, hanya terlihat pemiliknya.
  companyId String?
  company   CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        ComponentType
  question    String
  description String?
  options     Json?
  metadata    Json?

  /**
   * Usulan poin saat dipungut; tahapan tetap boleh menimpanya.
   */
  defaultPoints Int @default(10)

  /**
   * null berarti berlaku lintas bidang.
   * Soal soft skill, wawancara, dan etika kerja tidak dimiliki satu kategori
   * pekerjaan pun. Memaksanya memilih salah satu — katakanlah BACKEND —
   * membuatnya lenyap begitu perusahaan mencari marketer, padahal justru
   * soal semacam inilah yang paling luas dipakai.
   */
  categoryId String?
  category   Skill?              @relation("QuestionBankItemCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  difficulty ChallengeDifficulty

  /**
   * Soal yang ditarik peredarannya tetap disimpan demi ujian yang sudah memakainya.
   */
  isActive Boolean @default(true)

  tags QuestionBankItemSkill[]

  usedBy ChallengeComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, categoryId, difficulty])
  @@index([isActive, categoryId])
  @@map("question_bank_items")
}

/**
 * Penanda topik soal, memakai kosakata `Skill` yang sudah ada.
 */
model QuestionBankItemSkill {
  itemId  String
  item    QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([itemId, skillId])
  @@index([skillId])
  @@map("question_bank_item_skills")
}

// ==========================================
// 4. WORKSPACE & SUBMISSION
// ==========================================

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  DROPPED
}

model ChallengeEnrollment {
  id          String        @id @default(uuid())
  talentId    String
  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  status      EnrollmentStatus @default(ENROLLED)
  ndaSignedAt DateTime?
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  draftData   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  stageAttempts StageAttempt[]

  @@unique([talentId, challengeId])
  @@index([talentId, updatedAt(sort: Desc)])
  @@index([challengeId])
  @@map("challenge_enrollments")
}

enum SubmissionStatus {
  PENDING_AI
  UNDER_REVIEW
  PASSED
  FAILED
}

enum HiringStatus {
  NONE
  SHORTLISTED
  INTERVIEW_INVITED
  HIRED
  REJECTED
}

model Submission {
  id           String              @id @default(uuid())
  enrollmentId String
  enrollment   ChallengeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  talentId     String
  talent       TalentProfile       @relation(fields: [talentId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  /// Tahap yang dikumpulkan, bila ini pengumpulan per tahap.
  ///
  /// Nullable dengan sengaja: submisi yang dibuat sebelum pengerjaan dipecah
  /// per tahap mewakili seluruh challenge sekaligus, dan tetap sah. Baris
  /// dengan `sectionId` terisi adalah pengumpulan satu tahap.
  sectionId String?
  section   ChallengeSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  stageAttemptId String?       @unique
  stageAttempt   StageAttempt? @relation(fields: [stageAttemptId], references: [id], onDelete: SetNull)

  // Solusi yang dikumpulkan
  solutionFilesUrl String?
  repositoryUrl    String?
  figmaUrl         String?
  liveDemoUrl      String?
  notes            String?

  // Penanda bahwa perusahaan sudah diingatkan soal SLA tinjauan 7 hari.
  // Menjaga pengingat harian tidak berubah menjadi spam harian.
  slaReminderSentAt DateTime?

  // AI Correction & Integrity
  aiPlagiarismScore   Float? // 0.0 - 100.0%
  aiCorrectionSummary String? // Analisis otomatis dari AI
  aiScore             Float? // Skor awal dari AI (0-100)

  // Soft Skills
  softSkillScore    Float? // Agregasi skor soft skill (0-100)
  softSkillFeedback String? // Feedback AI khusus kepribadian/soft skill

  /// Hasil soal psikometrik, berbentuk profil per dimensi — bukan skor
  /// benar-salah.
  ///
  /// Sengaja terpisah dari `aiScore` dan `finalScore`. Jawaban skala Likert
  /// tidak punya jawaban benar, jadi memasukkannya ke nilai akhir akan
  /// mengubah ukuran "seberapa benar" menjadi campuran yang tidak bisa
  /// ditafsirkan. Bentuknya:
  /// `{ dimensions: [{ name, score, itemCount }], computedAt }` dengan skor
  /// 0-100 hasil normalisasi skala tiap soal.
  psychometricProfile Json?

  // Career Development
  weaknessTags String[] @default([])

  // Review Manusia & Keputusan
  finalScore       Float? // Skor dari rekruter
  reviewerFeedback String? // Ulasan kualitatif
  status           SubmissionStatus @default(PENDING_AI)
  hiringStatus     HiringStatus     @default(NONE)
  autoPassed       Boolean          @default(false)
  evaluatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio          Portfolio?
  componentResponses ComponentResponse[]

  // Cron evaluasi AI berjalan tiap 30 detik dan menyaring status PENDING_AI
  // lalu mengurutkan createdAt menaik. Tanpa indeks ini seluruh tabel dipindai
  // dua kali per menit.
  @@index([status, createdAt])
  @@index([challengeId, status])
  @@index([talentId])
  @@index([enrollmentId])
  @@index([sectionId])
  @@map("submissions")
}

model ComponentResponse {
  id           String             @id @default(uuid())
  submissionId String
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  componentId  String
  component    ChallengeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  // Nilai jawaban fleksibel
  textValue String? // Untuk Essay, URL, Live Coding, Option ID
  fileUrl   String? // Untuk File/Video

  score      Float? // Penilaian
  aiFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("component_responses")
}

// ==========================================
// 5. DISKUSI & Q&A
// ==========================================

model Discussion {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  message  String
  parentId String? // Untuk thread balasan (self-referencing)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([challengeId, createdAt])
  @@index([parentId])
  @@map("discussions")
}

// ==========================================
// 6. PORTFOLIO SHOWCASE
// ==========================================

model Portfolio {
  id           String        @id @default(uuid())
  talentId     String
  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  isPublic         Boolean @default(true)
  verifiedBadgeUrl String?
  showcaseSummary  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portfolios")
}

// ==========================================
// 7. GAMIFICATION & NOTIFICATIONS
// ==========================================

model Badge {
  id          String @id @default(uuid())
  title       String @unique
  description String
  iconUrl     String
  requiredXp  Int    @default(0)

  earnedBy TalentBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("badges")
}

model TalentBadge {
  id       String        @id @default(uuid())
  talentId String
  talent   TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime      @default(now())

  @@unique([talentId, badgeId])
  @@map("talent_badges")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  // Lonceng notifikasi menghitung yang belum dibaca per pengguna.
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ==========================================
// 8. TOKEN ECONOMY
// ==========================================

enum TokenType {
  EARN
  SPEND
}

model TokenTransaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        TokenType
  description String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("token_transactions")
}

// ==========================================
// 9. PAYMENT GATEWAY (MIDTRANS)
// ==========================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentType {
  TOKEN_TOPUP
  SUBSCRIPTION
}

model PaymentTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalId  String        @unique // Midtrans order_id
  checkoutUrl String? // Midtrans redirect_url
  amount      Int
  status      PaymentStatus @default(PENDING)
  paymentType PaymentType

  metadata Json? // Untuk menyimpan data spesifik paket (misal: tokenAmount)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payment_transactions")
}

// ==========================================
// 10. ADVANCED SUPER ADMIN FEATURES
// ==========================================

model SystemAuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "BANNED_USER", "CREATED_ANNOUNCEMENT"
  entityType String // e.g. "USER", "CHALLENGE"
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@map("system_audit_logs")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      TicketStatus @default(OPEN)

  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model TicketReply {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_replies")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  MAINTENANCE
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}
