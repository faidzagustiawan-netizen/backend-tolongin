# dotenv environment variable files
#
# Pola menyeluruh, bukan daftar varian. Daftar sebelumnya menyebut lima nama
# tepat, sehingga apa pun di luarnya lolos — dan itu bukan kemungkinan teoretis:
# VPS produksi menyimpan `.env.bak-20260728-221024` yang tidak diabaikan git.
# `git reset --hard` di skrip deploy tidak pernah membuang berkas tak terlacak,
# jadi berkas itu menetap, dan satu `git add -A` di sana cukup untuk mengirim
# rahasia produksi ke repositori.
.env*
# Kecuali contohnya, yang memang harus ikut terlacak — isinya nama kunci saja.
!.env.example

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# graphify knowledge graph (build artifact, regenerate with `graphify extract . --code-only`)
graphify-out/
.graphify_analysis.json
.graphify_labels.json

# Claude Code local config (contains machine-specific absolute paths)
.claude/

# Python (skrip mesin biometrik + lingkungan virtual ML)
